<Window x:Class="PandaChatbox.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panda Chatbox" Icon="favicon.ico" Width="480" Height="270"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{DynamicResource Text}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">
    <Border CornerRadius="12" BorderThickness="1" BorderBrush="#5B4BA8" MouseLeftButtonDown="Drag_Down">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#3A2B7A" Offset="0"/>
                <GradientStop Color="#27194F" Offset="0.75"/>
                <GradientStop Color="#2B1745" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- title -->
            <StackPanel Orientation="Horizontal" Margin="16,0">
                <Viewbox Width="26" Height="26" VerticalAlignment="Center">
                    <Canvas Width="48" Height="48">
                        <Ellipse Canvas.Left="4" Canvas.Top="3" Width="14" Height="14" Fill="#111111"/>
                        <Ellipse Canvas.Left="30" Canvas.Top="3" Width="14" Height="14" Fill="#111111"/>
                        <Ellipse Canvas.Left="6" Canvas.Top="9" Width="36" Height="36" Fill="White"/>
                        <Ellipse Canvas.Left="12" Canvas.Top="21" Width="10" Height="12" Fill="#111111"/>
                        <Ellipse Canvas.Left="26" Canvas.Top="21" Width="10" Height="12" Fill="#111111"/>
                        <Ellipse Canvas.Left="15" Canvas.Top="24" Width="5" Height="5" Fill="White"/>
                        <Ellipse Canvas.Left="28" Canvas.Top="24" Width="5" Height="5" Fill="White"/>
                        <Ellipse Canvas.Left="21" Canvas.Top="33" Width="6" Height="5" Fill="#FF5FD2"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="Panda Chatbox" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- body -->
            <Border Grid.Row="1" Margin="16,0,16,12" CornerRadius="8" Background="#1FFFFFFF" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Sit back, relax, and let us prepare your app" FontSize="17"/>

                    <Grid Height="8" Margin="0,16,0,16">
                        <Border CornerRadius="4" Background="#33FFFFFF"/>
                        <Border CornerRadius="4" RenderTransformOrigin="0,0.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                    <GradientStop Color="#F472D0" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="BarScale" ScaleX="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <TextBlock x:Name="PrevText" Foreground="#99FFFFFF" FontSize="12.5" TextTrimming="CharacterEllipsis" Margin="0,0,64,0"/>
                        <TextBlock x:Name="PrevTime" Foreground="#99FFFFFF" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <TextBlock x:Name="CurText" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,64,0"/>
                        <TextBlock x:Name="CurTime" Foreground="#CCFFFFFF" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock x:Name="NextText" Foreground="#80FFFFFF" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- footer -->
            <Border Grid.Row="2" CornerRadius="0,0,11,11">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1D1040" Offset="0"/>
                        <GradientStop Color="#3D1B55" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="18,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="By" FontSize="14" Foreground="#CCFFFFFF"/>
                        <TextBlock Text="AstralShadows" FontSize="14" FontWeight="SemiBold" Foreground="#C2A3FF" Margin="5,0,0,0"/>
                        <TextBlock Text="V3.1" FontSize="11.5" Foreground="#80FFFFFF" Margin="8,2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="Cancel" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0"
                            Padding="22,7" Background="#33FFFFFF" Click="Cancel_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
