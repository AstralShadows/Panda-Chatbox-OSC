<Window x:Class="PandaChatbox.TemplateBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Status template helper" Icon="favicon.ico" Width="700" Height="520"
        MinWidth="620" MinHeight="460" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Build a live status template" FontSize="23" FontWeight="Bold"/>
            <TextBlock Margin="0,5,0,14" Foreground="{DynamicResource Muted}"
                       Text="Select a token and insert it where the caret is. Values below are examples; the app fills in live values while running."/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,14,0">
                <TextBlock Text="Template" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="TemplateTextBox" MinHeight="86" MaxHeight="150"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         TextChanged="TemplateTextBox_TextChanged"/>
                <TextBlock x:Name="CharacterCount" Margin="0,6,0,0" Foreground="{DynamicResource Muted}"/>
                <TextBlock x:Name="LimitWarning" Margin="0,4,0,0" Foreground="{DynamicResource Bad}"
                           Text="Expanded preview exceeds VRChat's 144-character limit." Visibility="Collapsed"/>
                <TextBlock Text="Expanded preview" FontWeight="SemiBold" Margin="0,16,0,6"/>
                <Border Background="{DynamicResource PrevBg}" BorderBrush="{DynamicResource Edge}"
                        BorderThickness="1" CornerRadius="10" Padding="14" MinHeight="92">
                    <TextBlock x:Name="ExpandedPreview" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Available tokens" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ListBox x:Name="TokenList" SelectionChanged="TokenList_SelectionChanged" MinHeight="220"/>
                <Button x:Name="InsertTokenButton" Content="Insert selected token"
                        Margin="0,8,0,0" Padding="10,7" IsEnabled="False" Click="InsertToken_Click"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Padding="18,8" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Use template" Padding="18,8" IsDefault="True" Click="UseTemplate_Click"/>
        </StackPanel>
    </Grid>
</Window>
