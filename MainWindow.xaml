<Window x:Class="PandaChatbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PandaChatbox"
        Title="Panda Chatbox" Icon="favicon.ico" Width="1136" Height="810" MinWidth="980" MinHeight="640"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"
        RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Unspecified"
        Topmost="{Binding Topmost, Mode=TwoWay}"
        KeyDown="MainWindow_KeyDown">
    <Window.Resources>
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource CardHi}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Close"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E81123"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Tag" Value="Close"/>
                                    <Condition Property="IsPressed" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#C50F1F"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== header ===== -->
        <Border Grid.Row="0" Background="{DynamicResource Header}" BorderBrush="{DynamicResource Edge}" BorderThickness="0,0,0,2">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Canvas Width="48" Height="48" VerticalAlignment="Center" Margin="0,0,12,0"
                        MouseLeftButtonDown="Header_DragMove">
                    <Ellipse Canvas.Left="4" Canvas.Top="3" Width="14" Height="14" Fill="#111111"/>
                    <Ellipse Canvas.Left="30" Canvas.Top="3" Width="14" Height="14" Fill="#111111"/>
                    <Ellipse Canvas.Left="6" Canvas.Top="9" Width="36" Height="36" Fill="White"/>
                    <Ellipse Canvas.Left="12" Canvas.Top="21" Width="10" Height="12" Fill="#111111"/>
                    <Ellipse Canvas.Left="26" Canvas.Top="21" Width="10" Height="12" Fill="#111111"/>
                    <Ellipse Canvas.Left="15" Canvas.Top="24" Width="5" Height="5" Fill="White"/>
                    <Ellipse Canvas.Left="28" Canvas.Top="24" Width="5" Height="5" Fill="White"/>
                    <Ellipse Canvas.Left="21" Canvas.Top="33" Width="6" Height="5" Fill="{DynamicResource Pink}"/>
                </Canvas>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0"
                            MouseLeftButtonDown="Header_DragMove">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="VRC OSC" FontSize="12.5" Foreground="{DynamicResource Pink}"/>
                        <TextBlock Text="Made by AstralShadows" FontSize="12.5" Foreground="{DynamicResource Lilac}" Margin="10,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Panda Chatbox" FontSize="26" FontWeight="Bold" Margin="0,-3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource Tab}" Content="Status" Tag="0" IsChecked="True" Checked="Tab_Checked"/>
                    <RadioButton Style="{StaticResource Tab}" Content="Chat" Tag="1" Checked="Tab_Checked"/>
                    <RadioButton Style="{StaticResource Tab}" Content="Integrations" Tag="2" Checked="Tab_Checked"/>
                    <RadioButton Style="{StaticResource Tab}" Content="Settings" Tag="3" Checked="Tab_Checked"/>
                </StackPanel>

                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="Send to VRChat" FontSize="12.5" Foreground="{DynamicResource Muted}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Send}" Click="Send_Click"/>
                        <Ellipse x:Name="SendDot" Width="10" Height="10" Fill="{DynamicResource Green}" Margin="12,0,6,0"/>
                        <TextBlock x:Name="SendBadge" Text="Running" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource Green}"/>
                    </StackPanel>
                    <Button x:Name="UpdateButton" Content="Checking for updates..." Click="UpdateButton_Click"
                            HorizontalAlignment="Left" Margin="0,1,0,0" Padding="0" FontSize="9.5"
                            Foreground="{DynamicResource Muted}" Background="Transparent" BorderThickness="0"/>
                </StackPanel>

                <StackPanel x:Name="WindowButtons" Grid.Column="4" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Style="{StaticResource WindowControlButton}" Content="&#xE921;"
                            ToolTip="Minimize" Click="Minimize_Click"/>
                    <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButton}"
                            Content="&#xE922;" ToolTip="Maximize" Click="Maximize_Click"/>
                    <Button Style="{StaticResource WindowControlButton}" Content="&#xE8BB;" Tag="Close"
                            ToolTip="Close" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== body ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="16,14,6,12">

                <!-- ================= STATUS PAGE ================= -->
                <Grid x:Name="PageStatus" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowStatus}"
                                      ToolTip="Show the status line in your chatbox"/>
                        <Button DockPanel.Dock="Right" Content="Clear all" Margin="0,0,16,0" Padding="12,4" Click="ClearAll_Click"/>
                        <TextBlock DockPanel.Dock="Right" x:Name="StatusSummary" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Status messages"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0"
                                       Text="These rotate on the top line. Assign a collection per status; use {time}, {date}, {app}, {song}, {cpu}, {ram}, {vram}, {battery}, or {uptime} for live values."/>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer x:Name="StatusScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="StatusList" Margin="0,0,8,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" CornerRadius="8" Background="{DynamicResource Card}"
                                            AllowDrop="True" DragOver="Row_DragOver" Drop="Row_Drop">
                                        <Grid Height="42">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40"/>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="82"/>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="116"/>
                                                <ColumnDefinition Width="42"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- power / now-playing -->
                                            <Border Grid.Column="0" Background="{DynamicResource Field}" CornerRadius="8,0,0,8">
                                                <ToggleButton Style="{StaticResource PowerToggle}" Focusable="False"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay}" Click="RowChanged_Click"
                                                              ToolTip="Include in rotation"/>
                                            </Border>

                                            <!-- delete -->
                                            <Border Grid.Column="1" Background="{DynamicResource Card}">
                                                <Button Style="{StaticResource TrashButton}" Content="&#xE74D;" Focusable="False"
                                                        Click="RowDelete_Click" ToolTip="Delete"/>
                                            </Border>

                                            <!-- text (drag me / double-click to edit) -->
                                            <Border Grid.Column="2" Background="{DynamicResource CardHi}"
                                                    MouseLeftButtonDown="Text_MouseDown" MouseMove="Text_MouseMove">
                                                <Grid>
                                                    <TextBlock Text="{Binding Text}" Margin="14,0" FontSize="15"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                        <Setter Property="Opacity" Value="0.45"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Green}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Margin="5,5"
                                                             MaxLength="144" LostFocus="Edit_LostFocus" KeyDown="Edit_KeyDown"
                                                             IsVisibleChanged="Edit_VisibleChanged">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </Grid>
                                            </Border>

                                            <!-- status collection -->
                                            <Border Grid.Column="3" Background="{DynamicResource Field}" Padding="4,6">
                                                <TextBox Text="{Binding Collection, UpdateSourceTrigger=PropertyChanged}"
                                                         TextChanged="Collection_TextChanged" ToolTip="Collection name used by profiles and schedules"/>
                                            </Border>

                                            <!-- edit -->
                                            <Border Grid.Column="4" Background="{DynamicResource Card}">
                                                <ToggleButton Style="{StaticResource EditToggle}" Focusable="False"
                                                              IsChecked="{Binding IsEditing, Mode=TwoWay}" Click="EditToggle_Click" ToolTip="Edit"/>
                                            </Border>

                                            <!-- text style -->
                                            <Border Grid.Column="5" Background="{DynamicResource Field}" Padding="7,6">
                                                <ComboBox ItemsSource="{x:Static local:StatusStyles.Names}"
                                                          SelectedIndex="{Binding StyleIndex, Mode=TwoWay}"
                                                          ToolTip="Text style for this message"/>
                                            </Border>

                                            <!-- favorite -->
                                            <Border Grid.Column="6" Background="{DynamicResource CardHi}" CornerRadius="0,8,8,0">
                                                <ToggleButton Style="{StaticResource HeartToggle}" Focusable="False"
                                                              IsChecked="{Binding Favorite, Mode=TwoWay}" Click="RowChanged_Click"
                                                              ToolTip="Favorite"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyHint" Grid.Row="1" Style="{StaticResource MutedText}" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                               Text="No statuses yet. Type one below and press Create."/>

                    <!-- create bar -->
                    <Border Grid.Row="2" Margin="0,10,0,0" Padding="10" CornerRadius="10" Background="{DynamicResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="StatusEdit" Height="40" MaxLength="144" Padding="10,0,64,0"
                                         TextChanged="StatusEdit_TextChanged" KeyDown="StatusEdit_KeyDown"/>
                                <TextBlock x:Name="Placeholder" Text="Create here a new status" IsHitTestVisible="False"
                                           Foreground="{DynamicResource Muted}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="CreateCount" Text="0/144" IsHitTestVisible="False" FontSize="12"
                                           Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                            </Grid>
                            <TextBox x:Name="StatusCollectionEdit" Grid.Column="1" Height="40" Margin="8,0,0,0"
                                     Padding="8,0" VerticalContentAlignment="Center" Text="Default"
                                     ToolTip="Collection for the new status"/>
                            <Button Grid.Column="2" Style="{StaticResource Primary}" Content="Create" Height="40" Padding="24,0"
                                    Margin="10,0,0,0" Click="Add_Click"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= CHAT PAGE ================= -->
                <ScrollViewer x:Name="PageChat" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="0,0,10,0">
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Live chat message"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0"
                                           Text="Type something to say in game. Your specs are hidden and only your message shows for the display time set in Settings > Chatting options."/>
                                <TextBox x:Name="ChatEdit" Margin="0,12,0,0" MaxLength="144" KeyDown="ChatEdit_KeyDown"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource Primary}" Padding="22,9" Content="Send chat message" Click="SendChat_Click"/>
                                    <Button Padding="22,9" Content="Stop and show specs" Click="StopChat_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= INTEGRATIONS PAGE ================= -->
                <ScrollViewer x:Name="PageIntegrations" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                    <StackPanel Margin="0,0,10,0">
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Chatbox integrations"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,12"
                                           Text="Turn chatbox content on or off here. Detailed formatting, labels, and service options stay in Settings."/>
                                <StackPanel>
                                    <DockPanel Margin="4,7">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowStatus}" Click="IntegrationToggle_Click"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Status rotation"/>
                                    </DockPanel>
                                    <DockPanel Margin="4,7">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowCpu}" Click="IntegrationToggle_Click"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="CPU usage"/>
                                    </DockPanel>
                                    <DockPanel Margin="4,7">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowRam}" Click="IntegrationToggle_Click"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="RAM usage"/>
                                    </DockPanel>
                                    <DockPanel Margin="4,7">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowGpu}" Click="IntegrationToggle_Click"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="GPU name"/>
                                    </DockPanel>
                                    <DockPanel Margin="4,7">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowVram}" Click="IntegrationToggle_Click"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="VRAM usage"/>
                                    </DockPanel>
                                    <DockPanel Margin="4,7">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowTime}" Click="IntegrationToggle_Click"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Time"/>
                                    </DockPanel>
                                    <DockPanel Margin="4,7">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowDate}" Click="IntegrationToggle_Click"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Date"/>
                                    </DockPanel>
                                    <DockPanel Margin="4,7">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowWeather}" Click="IntegrationToggle_Click"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Weather"/>
                                    </DockPanel>
                                    <DockPanel Margin="4,7">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowMedia}" Click="IntegrationToggle_Click"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Now playing"/>
                                    </DockPanel>
                                    <DockPanel Margin="4,7">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowApp}" Click="IntegrationToggle_Click"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Foreground app"/>
                                    </DockPanel>
                                    <DockPanel Margin="4,7">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowBattery}" Click="IntegrationToggle_Click"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Battery"/>
                                    </DockPanel>
                                    <DockPanel Margin="4,7">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowUptime}" Click="IntegrationToggle_Click"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="PC uptime"/>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Media sources"/>
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,3,0,8"
                                           Text="Choose which players are included when Now playing is enabled or referenced by a status template."/>
                                <StackPanel>
                                    <DockPanel Margin="4,7">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding MediaSpotify}" Click="IntegrationToggle_Click"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Spotify"/>
                                    </DockPanel>
                                    <DockPanel Margin="4,7">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding MediaYoutube}" Click="IntegrationToggle_Click"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="YouTube"/>
                                    </DockPanel>
                                    <DockPanel Margin="4,7">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding MediaOther}" Click="IntegrationToggle_Click"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Other players"/>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ================= SETTINGS PAGE ================= -->
                <Grid x:Name="PageSettings" Margin="0,0,10,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Collapse all" Margin="0" Padding="12,4" Click="CollapseAll_Click"/>
                        <Button DockPanel.Dock="Right" Content="Expand all" Margin="0,0,8,0" Padding="12,4" Click="ExpandAll_Click"/>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Settings"/>
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,0"
                                       Text="Click a section to open it. Changes apply live. A red outline means an invalid value."/>
                        </StackPanel>
                    </DockPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SettingsStack" Margin="0,0,8,0">

                            <!-- ===== Status profiles and schedules ===== -->
                            <Expander Style="{StaticResource Section}" Header="Status profiles &amp; schedules">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                               Text="Profiles select a named status collection. Manual selection overrides schedules and app matching until Auto is selected. Schedules take priority over app matching and support overnight times."/>
                                    <DockPanel Margin="0,12,0,0">
                                        <ComboBox x:Name="ManualProfileCombo" DockPanel.Dock="Right" Width="220"
                                                  SelectionChanged="ManualProfileCombo_SelectionChanged"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Active profile"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,6,0,0">
                                        <TextBlock x:Name="ActiveProfileText" Style="{StaticResource Hint}" Text="Automatic: scheduled, then foreground app, then all statuses."/>
                                    </DockPanel>

                                    <Border Style="{StaticResource SubCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SubTitle}" Text="App-matched profiles"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="Fields below: profile name · text found in the app/window title (blank for manual-only) · collection"/>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="ProfileNameEdit" Margin="0,0,6,0" ToolTip="Profile name"/>
                                                <TextBox x:Name="ProfileAppEdit" Grid.Column="1" Margin="6,0" ToolTip="Match any part of app name, executable, or window title"/>
                                                <TextBox x:Name="ProfileCollectionEdit" Grid.Column="2" Margin="6,0" Text="Default" ToolTip="Status collection to activate"/>
                                                <Button Grid.Column="3" Content="Add" Padding="14,6" Margin="6,0,0,0" Click="AddProfile_Click"/>
                                            </Grid>
                                            <DataGrid x:Name="ProfilesGrid" Margin="0,8,0,0" Height="140"
                                                      ItemsSource="{Binding StatusProfiles}"
                                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                                      HeadersVisibility="Column" SelectionMode="Single"
                                                      CellEditEnding="Profiles_CellEditEnding">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Profile" Binding="{Binding Name}" IsReadOnly="True" Width="*"/>
                                                    <DataGridTextColumn Header="App / window contains" Binding="{Binding AppMatch, UpdateSourceTrigger=PropertyChanged}" Width="1.5*"/>
                                                    <DataGridTextColumn Header="Collection" Binding="{Binding Collection, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <Button Content="Remove selected profile" HorizontalAlignment="Right" Padding="12,6"
                                                    Margin="0,8,0,0" Click="RemoveProfile_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SubCard}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SubTitle}" Text="Scheduled collections"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="Fields below: schedule name · start · end · collection. Use 24-hour HH:mm times; end may be earlier than start for overnight schedules."/>
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="ScheduleNameEdit" Margin="0,0,6,0" ToolTip="Schedule name"/>
                                                <TextBox x:Name="ScheduleStartEdit" Grid.Column="1" Margin="6,0" Text="09:00" ToolTip="Start time (HH:mm)"/>
                                                <TextBox x:Name="ScheduleEndEdit" Grid.Column="2" Margin="6,0" Text="17:00" ToolTip="End time (HH:mm)"/>
                                                <TextBox x:Name="ScheduleCollectionEdit" Grid.Column="3" Margin="6,0" Text="Default" ToolTip="Status collection to activate"/>
                                                <Button Grid.Column="4" Content="Add" Padding="14,6" Margin="6,0,0,0" Click="AddSchedule_Click"/>
                                            </Grid>
                                            <DataGrid x:Name="SchedulesGrid" Margin="0,8,0,0" Height="140"
                                                      ItemsSource="{Binding ScheduledProfiles}"
                                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                                      HeadersVisibility="Column" SelectionMode="Single"
                                                      CellEditEnding="Schedules_CellEditEnding">
                                                <DataGrid.Columns>
                                                    <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="42"/>
                                                    <DataGridTextColumn Header="Schedule" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                                    <DataGridTextColumn Header="Start" Binding="{Binding StartTime, UpdateSourceTrigger=PropertyChanged}" Width="72"/>
                                                    <DataGridTextColumn Header="End" Binding="{Binding EndTime, UpdateSourceTrigger=PropertyChanged}" Width="72"/>
                                                    <DataGridTextColumn Header="Collection" Binding="{Binding Collection, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <Button Content="Remove selected schedule" HorizontalAlignment="Right" Padding="12,6"
                                                    Margin="0,8,0,0" Click="RemoveSchedule_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Expander>

                            <Expander Style="{StaticResource Section}" Header="Quick status presets">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                               Text="Define instant status actions and assign a keyboard shortcut such as Ctrl+Alt+1. If you leave the message blank, the preset just switches to the chosen collection."/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="QuickPresetNameEdit" Margin="0,0,6,0" ToolTip="Preset name"/>
                                        <TextBox x:Name="QuickPresetMessageEdit" Grid.Column="1" Margin="6,0" ToolTip="Status text to send (optional)"/>
                                        <TextBox x:Name="QuickPresetCollectionEdit" Grid.Column="2" Margin="6,0" Text="Default" ToolTip="Target collection"/>
                                        <TextBox x:Name="QuickPresetHotkeyEdit" Grid.Column="3" Margin="6,0" ToolTip="Shortcut like Ctrl+Alt+1"/>
                                        <Button Grid.Column="4" Content="Add" Padding="14,6" Margin="6,0,0,0" Click="AddQuickPreset_Click"/>
                                    </Grid>
                                    <DataGrid x:Name="QuickPresetsGrid" Margin="0,8,0,0" Height="140"
                                              ItemsSource="{Binding QuickStatusPresets}"
                                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                              HeadersVisibility="Column" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="42"/>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                            <DataGridTextColumn Header="Message" Binding="{Binding Message, UpdateSourceTrigger=PropertyChanged}" Width="1.6*"/>
                                            <DataGridTextColumn Header="Collection" Binding="{Binding Collection, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                            <DataGridTextColumn Header="Hotkey" Binding="{Binding Hotkey, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button Content="Remove selected preset" HorizontalAlignment="Right" Padding="12,6"
                                            Margin="0,8,0,0" Click="RemoveQuickPreset_Click"/>
                                </StackPanel>
                            </Expander>

                            <!-- ===== Settings backup ===== -->
                            <Expander Style="{StaticResource Section}" Header="Settings backup">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                               Text="Export or restore your app settings, status messages, collections, profiles, and schedules as a JSON file."/>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Style="{StaticResource Primary}" Content="Export settings" Padding="16,8" Click="ExportSettings_Click"/>
                                        <Button Content="Import settings" Padding="16,8" Margin="8,0,0,0" Click="ImportSettings_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <!-- ===== Status options ===== -->
                            <Expander Style="{StaticResource Section}" Header="Status options">
                                <StackPanel>
                                    <DockPanel Margin="0,10,0,0">
                                        <TextBlock Style="{StaticResource Hint}" Text="Enable or disable Status rotation from the Integrations tab."/>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <ComboBox DockPanel.Dock="Right" Width="180" SelectedIndex="{Binding StatusMode}"
                                                  SelectionChanged="StatusMode_Changed">
                                            <ComboBoxItem Content="In order"/>
                                            <ComboBoxItem Content="Random"/>
                                            <ComboBoxItem Content="Favorites only"/>
                                        </ComboBox>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="Rotation order"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="Random rotates within the active collection. Favorites only falls back to everything if none are hearted."/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,14,0,0">
                                        <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"
                                                   Foreground="{DynamicResource Lilac}"
                                                   Text="{Binding Value, ElementName=sld_MessageDelay, StringFormat={}{0:0.0}s}"/>
                                        <StackPanel DockPanel.Dock="Left" Width="230">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="Rotation speed"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="How often the status changes. VRChat works best at 1.5s or slower."/>
                                        </StackPanel>
                                        <Slider x:Name="sld_MessageDelay" Minimum="1.5" Maximum="30" TickFrequency="0.5" SmallChange="0.5" LargeChange="0.5"
                                                Value="{Binding MessageDelay, Mode=TwoWay}"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <TextBox DockPanel.Dock="Right" Width="160" MaxLength="20"
                                                 Text="{Binding StatusPrefix, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Text before every status"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,10,0,0">
                                        <TextBox DockPanel.Dock="Right" Width="160" MaxLength="20"
                                                 Text="{Binding StatusSuffix, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Text after every status"/>
                                    </DockPanel>
                                </StackPanel>
                            </Expander>

                            <!-- ===== Component stats ===== -->
                            <Expander Style="{StaticResource Section}" Header="Component stats options">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                               Text="Detected models and memory usage are real system readings; customize only their labels below. FPS isn't reported because Windows can't provide a reliable system-wide value."/>

                                    <DockPanel Margin="0,14,0,0">
                                        <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"
                                                   Foreground="{DynamicResource Lilac}"
                                                   Text="{Binding Value, ElementName=sld_HardwareUpdateInterval, StringFormat={}{0:0.0}s}"/>
                                        <StackPanel DockPanel.Dock="Left" Width="230">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="Hardware refresh interval"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="How often CPU, RAM, and VRAM readings update (0.5-10 seconds)."/>
                                        </StackPanel>
                                        <Slider x:Name="sld_HardwareUpdateInterval" Minimum="0.5" Maximum="10" TickFrequency="0.5" SmallChange="0.5" LargeChange="0.5"
                                                Value="{Binding HardwareUpdateInterval, Mode=TwoWay}"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,12,0,0">
                                        <TextBox DockPanel.Dock="Right" Width="70" MaxLength="6"
                                                 Text="{Binding StatSeparator, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Separator between name and value"/>
                                    </DockPanel>

                                    <!-- CPU -->
                                    <Border Style="{StaticResource SubCard}">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,16,0">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Label"/>
                                                    <TextBox Width="120" MaxLength="24" Text="{Binding TagCpu, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource SubTitle}" Text="CPU"/>
                                            </DockPanel>
                                            <WrapPanel Margin="0,6,0,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,6,18,0" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Detected"/>
                                                    <TextBlock x:Name="CpuDetectedText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Show name"/>
                                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding ShowCpuName}"/>
                                                </StackPanel>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- RAM -->
                                    <Border Style="{StaticResource SubCard}">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,16,0">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Label"/>
                                                    <TextBox Width="120" MaxLength="24" Text="{Binding TagRam, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource SubTitle}" Text="RAM"/>
                                            </DockPanel>
                                            <WrapPanel Margin="0,6,0,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,6,18,0" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Detected"/>
                                                    <TextBlock x:Name="RamDetectedText" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Show %"/>
                                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding ShowRamPercent}"/>
                                                </StackPanel>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- GPU -->
                                    <Border Style="{StaticResource SubCard}">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,16,0">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Label"/>
                                                    <TextBox Width="120" MaxLength="24" Text="{Binding TagGpu, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource SubTitle}" Text="GPU"/>
                                            </DockPanel>
                                            <TextBlock x:Name="GpuDetectedText" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- VRAM -->
                                    <Border Style="{StaticResource SubCard}">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,16,0">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Label"/>
                                                    <TextBox Width="120" MaxLength="24" Text="{Binding TagVram, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource SubTitle}" Text="VRAM"/>
                                            </DockPanel>
                                            <WrapPanel Margin="0,6,0,0">
                                                <StackPanel Orientation="Horizontal" Margin="0,6,18,0" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Detected"/>
                                                    <TextBlock x:Name="VramDetectedText" VerticalAlignment="Center" ToolTip="{Binding VramUsageError}"/>
                                                </StackPanel>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Expander>

                            <!-- ===== Time ===== -->
                            <Expander Style="{StaticResource Section}" Header="Time options">
                                <StackPanel>
                                    <DockPanel Margin="0,10,0,0">
                                        <TextBlock Style="{StaticResource Hint}" Text="Enable Time and Date from the Integrations tab."/>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding H24}"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="24-hour clock"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowSeconds}"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Show seconds"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <ComboBox DockPanel.Dock="Right" Width="180" SelectedIndex="{Binding DateStyle}">
                                            <ComboBoxItem Content="Mon, Jan 5"/>
                                            <ComboBoxItem Content="1/5 (month/day)"/>
                                            <ComboBoxItem Content="5/1 (day/month)"/>
                                            <ComboBoxItem Content="Jan 5, 2026"/>
                                            <ComboBoxItem Content="2026-01-05"/>
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Date format"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <TextBox DockPanel.Dock="Right" Width="150" Text="{Binding TagTime, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Time label"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,10,0,0">
                                        <TextBox DockPanel.Dock="Right" Width="150" Text="{Binding TagDate, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Date label"/>
                                    </DockPanel>
                                </StackPanel>
                            </Expander>

                            <!-- ===== Weather ===== -->
                            <Expander Style="{StaticResource Section}" Header="Weather options">
                                <StackPanel>
                                    <DockPanel Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" Text="Enable Weather from the Integrations tab. Current weather is from wttr.in; blank city auto-detects."/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <TextBox DockPanel.Dock="Right" Width="200" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="City"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Fahrenheit}"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Use Fahrenheit"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <TextBox DockPanel.Dock="Right" Width="70" Text="{Binding WeatherMinutes, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Refresh every (minutes)"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,10,0,0">
                                        <TextBox DockPanel.Dock="Right" Width="150" MaxLength="24" Text="{Binding TagWeather, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Label"/>
                                    </DockPanel>
                                    <TextBlock x:Name="WeatherStatusText" Margin="0,12,0,0" FontSize="12.5" Foreground="{DynamicResource Lilac}"/>
                                </StackPanel>
                            </Expander>

                            <!-- ===== Media ===== -->
                            <Expander Style="{StaticResource Section}" Header="Now playing (Spotify, YouTube, ...) options">
                                <StackPanel>
                                    <DockPanel Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" Text="Enable Now playing and choose media sources from the Integrations tab. Paused media is ignored."/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowMediaApp}"/>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="Show player name"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="Adds (Spotify) after the song."/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <TextBox DockPanel.Dock="Right" Width="70" Text="{Binding MediaMax, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Max song length (10-100)"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,10,0,0">
                                        <TextBox DockPanel.Dock="Right" Width="150" MaxLength="24" Text="{Binding TagMusic, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Label"/>
                                    </DockPanel>
                                    <TextBlock x:Name="MediaStatusText" Margin="0,12,0,0" FontSize="12.5" Foreground="{DynamicResource Lilac}"/>
                                </StackPanel>
                            </Expander>

                            <!-- ===== App ===== -->
                            <Expander Style="{StaticResource Section}" Header="App options">
                                <StackPanel>
                                    <DockPanel Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Hint}" Text="Enable Foreground app from the Integrations tab."/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <TextBox DockPanel.Dock="Right" Width="150" MaxLength="24" Text="{Binding TagApp, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Label"/>
                                    </DockPanel>
                                </StackPanel>
                            </Expander>

                            <!-- ===== Battery / uptime ===== -->
                            <Expander Style="{StaticResource Section}" Header="Battery &amp; uptime options">
                                <StackPanel>
                                    <DockPanel Margin="0,10,0,0">
                                        <TextBlock Style="{StaticResource Hint}" Text="Enable Battery from the Integrations tab."/>
                                    </DockPanel>
                                    <DockPanel Margin="0,10,0,0">
                                        <TextBox DockPanel.Dock="Right" Width="150" MaxLength="24" Text="{Binding TagBattery, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Battery label"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,14,0,0">
                                        <TextBlock Style="{StaticResource Hint}" Text="Enable PC uptime from the Integrations tab."/>
                                    </DockPanel>
                                    <DockPanel Margin="0,10,0,0">
                                        <TextBox DockPanel.Dock="Right" Width="150" MaxLength="24" Text="{Binding TagUptime, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Uptime label"/>
                                    </DockPanel>
                                </StackPanel>
                            </Expander>

                            <!-- ===== Chatting ===== -->
                            <Expander Style="{StaticResource Section}" Header="Chatting options">
                                <StackPanel>
                                    <DockPanel Margin="0,14,0,0">
                                        <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"
                                                   Foreground="{DynamicResource Lilac}"
                                                   Text="{Binding Value, ElementName=sld_ChatDuration, StringFormat={}{0:0.0}s}"/>
                                        <StackPanel DockPanel.Dock="Left" Width="230">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="Chat display time"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="How long a chat message stays before the specs come back."/>
                                        </StackPanel>
                                        <Slider x:Name="sld_ChatDuration" Minimum="1" Maximum="15" TickFrequency="0.5" SmallChange="0.5" LargeChange="0.5"
                                                Value="{Binding ChatDuration, Mode=TwoWay}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Expander>

                            <!-- ===== Chatbox behavior ===== -->
                            <Expander Style="{StaticResource Section}" Header="Chatbox behavior">
                                <StackPanel>
                                    <DockPanel Margin="0,10,0,0">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Immediate}"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Send instantly (skip the keyboard popup)"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Sound}"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Play the notification sound"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding TrimToLimit}"/>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="Trim to 144 characters"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="Cuts the end off instead of letting VRChat do it."/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,14,0,0">
                                        <TextBlock DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"
                                                   Foreground="{DynamicResource Lilac}"
                                                   Text="{Binding Value, ElementName=sld_MinSend, StringFormat={}{0:0.0}s}"/>
                                        <StackPanel DockPanel.Dock="Left" Width="230">
                                            <TextBlock Style="{StaticResource RowLabel}" Text="Minimum time between sends"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="0 = no limit. Try 1.5s if VRChat drops updates."/>
                                        </StackPanel>
                                        <Slider x:Name="sld_MinSend" Minimum="0" Maximum="5" TickFrequency="0.1" SmallChange="0.1" LargeChange="0.1"
                                                Value="{Binding MinSendInterval, Mode=TwoWay}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Expander>

                            <!-- ===== Connection ===== -->
                            <Expander Style="{StaticResource Section}" Header="Connection (OSC)">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0" Text="VRChat listens on 127.0.0.1 port 9000 by default."/>
                                    <DockPanel Margin="0,12,0,0">
                                        <TextBox DockPanel.Dock="Right" Width="150" Text="{Binding Ip, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="IP address"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,10,0,0">
                                        <TextBox DockPanel.Dock="Right" Width="150" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Port"/>
                                    </DockPanel>
                                    <Button Style="{StaticResource Primary}" Content="Apply connection" Margin="0,14,0,0"
                                            HorizontalAlignment="Left" Click="Apply_Click"/>
                                </StackPanel>
                            </Expander>

                            <!-- ===== Appearance ===== -->
                            <Expander Style="{StaticResource Section}" Header="Appearance &amp; window">
                                <StackPanel>
                                    <DockPanel Margin="0,10,0,0">
                                        <ComboBox DockPanel.Dock="Right" Width="180" SelectedIndex="{Binding ThemeIndex}"
                                                  SelectionChanged="Theme_Changed">
                                            <ComboBoxItem Content="Midnight"/>
                                            <ComboBoxItem Content="Violet"/>
                                            <ComboBoxItem Content="Rose"/>
                                            <ComboBoxItem Content="Mint"/>
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Color theme"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <TextBlock DockPanel.Dock="Right" Width="52" TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Muted}"
                                                   Text="{Binding SurfaceTransparency, StringFormat={}{0:P0}}"/>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="Surface transparency"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="Makes panels see-through over the background."/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Slider Minimum="0" Maximum="0.75" TickFrequency="0.05" SmallChange="0.01"
                                            Value="{Binding SurfaceTransparency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ValueChanged="SurfaceTransparency_Changed"/>
                                    <DockPanel Margin="0,12,0,0">
                                        <Button DockPanel.Dock="Right" Content="Apply" Padding="10,4" Margin="6,0,0,0"
                                                Click="ApplyTextColor_Click"/>
                                        <TextBox x:Name="TextColorBox" Width="100" HorizontalAlignment="Right"
                                                 Text="#FFFFFF" MaxLength="7" CharacterCasing="Upper"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Text color"/>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                               Text="Enter a hex color such as #FFFFFF."/>
                                    <DockPanel Margin="0,12,0,0">
                                        <ComboBox DockPanel.Dock="Right" Width="180" SelectedIndex="{Binding BackgroundMode, Mode=TwoWay}"
                                                  SelectionChanged="BackgroundMode_Changed">
                                            <ComboBoxItem Content="Theme background"/>
                                            <ComboBoxItem Content="Color shifter"/>
                                            <ComboBoxItem Content="Picture"/>
                                        </ComboBox>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Custom background"/>
                                    </DockPanel>
                                    <StackPanel x:Name="SolidColorSettings" Visibility="Collapsed" Margin="0,8,0,0">
                                        <DockPanel Margin="0,4,0,0">
                                            <Border x:Name="BackgroundColorPreview" DockPanel.Dock="Right" Width="40" Height="24"
                                                    BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="5"/>
                                            <TextBlock x:Name="BackgroundColorHex" Style="{StaticResource MutedText}"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,8,0,0">
                                            <TextBlock DockPanel.Dock="Left" Width="100" Style="{StaticResource FieldLabel}" Text="Hue"/>
                                            <Slider Minimum="0" Maximum="360" Value="{Binding BackgroundHue}"
                                                    ValueChanged="BackgroundColor_Changed"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,6,0,0">
                                            <TextBlock DockPanel.Dock="Left" Width="100" Style="{StaticResource FieldLabel}" Text="Saturation"/>
                                            <Slider Minimum="0" Maximum="1" Value="{Binding BackgroundSaturation}"
                                                    ValueChanged="BackgroundColor_Changed"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,6,0,0">
                                            <TextBlock DockPanel.Dock="Left" Width="100" Style="{StaticResource FieldLabel}" Text="Brightness"/>
                                            <Slider Minimum="0" Maximum="1" Value="{Binding BackgroundBrightness}"
                                                    ValueChanged="BackgroundColor_Changed"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel x:Name="PictureSettings" Visibility="Collapsed" Margin="0,8,0,0">
                                        <Button Content="Choose picture..." HorizontalAlignment="Left"
                                                Click="ChooseBackground_Click"/>
                                        <TextBlock x:Name="BackgroundImageName" Style="{StaticResource Hint}"
                                                   Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Topmost}"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Always on top"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                                      IsChecked="{Binding CustomWindowControls}"
                                                      Checked="CustomWindowControls_Changed"
                                                      Unchecked="CustomWindowControls_Changed"/>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="Use in-app window controls"/>
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Replaces the Windows title bar buttons. Turn off to use the standard title bar."/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowSplash}"/>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource RowLabel}" Text="Show the startup screen"/>
                                            <TextBlock Style="{StaticResource Hint}" Text="Takes effect next time you open the app."/>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Expander>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ===== preview side panel ===== -->
            <Border Grid.Column="1" Background="{DynamicResource Panel}">
                <Grid Margin="14,12,14,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="Preview" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="CountText" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="12.5" Foreground="{DynamicResource Muted}"/>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,12,0,0" Height="270" CornerRadius="20" Background="{DynamicResource PrevBg}"
                            BorderBrush="{DynamicResource Edge}" BorderThickness="1">
                        <TextBlock x:Name="PreviewText" TextWrapping="Wrap" TextAlignment="Center"
                                   VerticalAlignment="Center" Margin="12" FontSize="14.5"/>
                    </Border>

                    <TextBlock x:Name="OverWarning" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"
                               FontSize="12.5" Foreground="{DynamicResource Bad}" Visibility="Collapsed"
                               Text="Over 144 characters. VRChat will cut off the end, so turn off a line or shorten a name."/>

                    <Border Grid.Row="3" Margin="0,12,0,0" Background="{DynamicResource Card}" CornerRadius="14" Padding="8,5">
                        <TextBlock x:Name="ConnText" HorizontalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Lilac}"/>
                    </Border>

                    <StackPanel Grid.Row="5" VerticalAlignment="Bottom">
                        <Button Margin="0,0,0,10" Padding="0,10" Content="Rearrange" Click="RearrangeLines_Click"/>
                        <Button Style="{StaticResource Primary}" Margin="0,0,0,10" Padding="0,10" Content="Send now" Click="SendNow_Click"/>
                        <Button Margin="0,0,0,12" Padding="0,10" Content="Clear chatbox" Click="Clear_Click"/>
                        <TextBlock Text="© 2026 AstralShadows" HorizontalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
                        <TextBlock Text="Panda Chatbox  V3.3.1 (C#)" HorizontalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource Off}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
