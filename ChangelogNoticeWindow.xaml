<Window x:Class="PandaChatbox.ChangelogNoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panda Chatbox changelog" Icon="favicon.ico" Width="560" Height="500"
        MinWidth="460" MinHeight="360"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True">
    <Border CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Edge}"
            Background="{DynamicResource Panel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource Header}" CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="18,0,10,0">
                    <TextBlock Text="Panda Chatbox changelog" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Content="&#xE8BB;" FontFamily="{StaticResource Icons}" FontSize="12"
                            Width="32" Height="30" Padding="0" Margin="0" HorizontalAlignment="Right"
                            VerticalAlignment="Center" ToolTip="Close" Click="Close_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,18,24,12">
                <TextBlock Text="What changed" FontSize="21" FontWeight="Bold"/>
                <TextBlock x:Name="VersionText" Margin="0,6,0,0" FontSize="15"
                           Foreground="{DynamicResource Lilac}"/>
            </StackPanel>

            <Border Grid.Row="2" Margin="24,0,24,14" Padding="12"
                    Background="{DynamicResource PrevBg}" BorderBrush="{DynamicResource Edge}"
                    BorderThickness="1" CornerRadius="8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="13"
                               Foreground="{DynamicResource Text}"/>
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="18,0,18,18">
                <Button Content="Close" Padding="16,8" Click="Close_Click"/>
                <Button Style="{StaticResource Primary}" Content="View release" Padding="16,8"
                        Margin="8,0,0,0" Click="ViewRelease_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
